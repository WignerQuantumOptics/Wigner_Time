\PYG{c+c1}{\PYGZsh{}                   Experimental stages                                   \PYGZsh{}}
\PYG{c+c1}{\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}\PYGZsh{}}
\PYG{c+c1}{\PYGZsh{} NOTE: The idea behind the function wrapping is that we enclose what will rarely change and expose just those attributes that we are likely to want to vary.}


\PYG{k}{def} \PYG{n+nf}{default\PYGZus{}state}\PYG{p}{(}\PYG{n}{f}\PYG{o}{=}\PYG{n}{tl}\PYG{o}{.}\PYG{n}{create}\PYG{p}{,} \PYG{n}{MOT\PYGZus{}ON}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{,} \PYG{o}{**}\PYG{n}{kwargs}\PYG{p}{):}
    \PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Starts/leaves the system in a sane state that is appropriate for creating a new timeline}

\PYG{l+s+sd}{    As a general rule, AOMs are kept on as long as possible to keep them in thermal equilibrium. When needed, we turn them off before the opening of the shutter.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{k}{return} \PYG{n}{tl}\PYG{o}{.}\PYG{n}{stack}\PYG{p}{(}
        \PYG{n}{f}\PYG{p}{(}
            \PYG{n}{lockbox\PYGZus{}MOT\PYGZus{}\PYGZus{}MHz}\PYG{o}{=}\PYG{l+m+mf}{0.0}\PYG{p}{,}
            \PYG{n}{AOM\PYGZus{}MOT}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{,}
            \PYG{n}{AOM\PYGZus{}repump}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{,}
            \PYG{n}{AOM\PYGZus{}OP}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{,}
            \PYG{n}{AOM\PYGZus{}science}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{,}
            \PYG{n}{shutter\PYGZus{}MOT}\PYG{o}{=}\PYG{n+nb}{int}\PYG{p}{(}\PYG{n}{MOT\PYGZus{}ON}\PYG{p}{),}
            \PYG{n}{shutter\PYGZus{}repump}\PYG{o}{=}\PYG{n+nb}{int}\PYG{p}{(}\PYG{n}{MOT\PYGZus{}ON}\PYG{p}{),}
            \PYG{n}{shutter\PYGZus{}OP1}\PYG{o}{=}\PYG{l+m+mi}{0}\PYG{p}{,}
            \PYG{n}{shutter\PYGZus{}OP2}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{,}
            \PYG{n}{shutter\PYGZus{}science}\PYG{o}{=}\PYG{l+m+mi}{0}\PYG{p}{,}
            \PYG{n}{shutter\PYGZus{}transverse\PYGZus{}pump}\PYG{o}{=}\PYG{l+m+mi}{0}\PYG{p}{,}
            \PYG{n}{AOM\PYGZus{}science\PYGZus{}\PYGZus{}trans}\PYG{o}{=}\PYG{l+m+mf}{1.0}\PYG{p}{,}
            \PYG{o}{**}\PYG{n}{kwargs}\PYG{p}{,}
        \PYG{p}{)}
    \PYG{p}{)}


\PYG{k}{def} \PYG{n+nf}{init}\PYG{p}{(}\PYG{o}{**}\PYG{n}{kwargs}\PYG{p}{):}
    \PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Time is simply a placeholder here as `ADwin\PYGZus{}LowInit` is a \PYGZsq{}special\PYGZsq{} context, that will be treated differently by the ADwin system.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{k}{return} \PYG{n}{default\PYGZus{}state}\PYG{p}{(}
        \PYG{n}{t}\PYG{o}{=\PYGZhy{}}\PYG{l+m+mf}{1e\PYGZhy{}6}\PYG{p}{,}
        \PYG{n}{context}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}ADwin\PYGZus{}LowInit\PYGZdq{}}\PYG{p}{,}
        \PYG{o}{**}\PYG{n}{kwargs}\PYG{p}{,}
    \PYG{p}{)}


\PYG{k}{def} \PYG{n+nf}{finish}\PYG{p}{(}\PYG{n}{wait}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{n}{lower\PYGZus{}current}\PYG{o}{=\PYGZhy{}}\PYG{l+m+mf}{1.0}\PYG{p}{,} \PYG{n}{upper\PYGZus{}current}\PYG{o}{=\PYGZhy{}}\PYG{l+m+mf}{0.98}\PYG{p}{,} \PYG{n}{MOT\PYGZus{}ON}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{,} \PYG{o}{**}\PYG{n}{kwargs}\PYG{p}{):}
    \PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Safely winds down the system, \PYGZsq{}ramping\PYGZsq{} the analog variables to the “default state” in a given duration by the default `ramp\PYGZus{}function`.}

\PYG{l+s+sd}{    The `anchor` function is used to specify a key time instant, around which other times can be specified.}

\PYG{l+s+sd}{    The `ADwin\PYGZus{}Finish` is again a special context. It means that the “default state” will be actuated even when the process is interrupted, and time is again just fictive in the `default\PYGZus{}state` call}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{duration} \PYG{o}{=} \PYG{l+m+mf}{1e\PYGZhy{}2}

    \PYG{k}{return} \PYG{n}{tl}\PYG{o}{.}\PYG{n}{stack}\PYG{p}{(}
        \PYG{n}{tl}\PYG{o}{.}\PYG{n}{anchor}\PYG{p}{(}\PYG{n}{wait}\PYG{p}{,} \PYG{n}{context}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}finalize\PYGZdq{}}\PYG{p}{),}
        \PYG{n}{tl}\PYG{o}{.}\PYG{n}{ramp}\PYG{p}{(}
            \PYG{n}{lockbox\PYGZus{}MOT\PYGZus{}\PYGZus{}MHz}\PYG{o}{=}\PYG{l+m+mf}{0.0}\PYG{p}{,}
            \PYG{n}{coil\PYGZus{}MOTlower\PYGZus{}\PYGZus{}A}\PYG{o}{=}\PYG{n}{lower\PYGZus{}current}\PYG{p}{,}
            \PYG{n}{coil\PYGZus{}MOTupper\PYGZus{}\PYGZus{}A}\PYG{o}{=}\PYG{n}{upper\PYGZus{}current}\PYG{p}{,}
            \PYG{n}{duration}\PYG{o}{=}\PYG{n}{duration}\PYG{p}{,}
            \PYG{n}{context}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}finalize\PYGZdq{}}\PYG{p}{,}
        \PYG{p}{),}
        \PYG{n}{default\PYGZus{}state}\PYG{p}{(}
            \PYG{n}{f}\PYG{o}{=}\PYG{n}{tl}\PYG{o}{.}\PYG{n}{update}\PYG{p}{,}
            \PYG{n}{t}\PYG{o}{=}\PYG{n}{duration}\PYG{o}{+}\PYG{l+m+mf}{1e\PYGZhy{}6}\PYG{p}{,}
            \PYG{n}{context}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}ADwin\PYGZus{}Finish\PYGZdq{}}\PYG{p}{,}
            \PYG{n}{MOT\PYGZus{}ON}\PYG{o}{=}\PYG{n}{MOT\PYGZus{}ON}\PYG{p}{,}
            \PYG{o}{**}\PYG{n}{kwargs}\PYG{p}{,}
