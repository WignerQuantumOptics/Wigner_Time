\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{`connections` allows us to label physical links (inputs and outputs) between devices and the timing system. By using labels that follow a particular regex, defined within the `variable` module, we can separate out the design and the implementation of our experiment.}
\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{n}{connections} \PYG{o}{=} \PYG{n}{adcon}\PYG{o}{.}\PYG{n}{new}\PYG{p}{(}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}shutter\PYGZus{}MOT\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{11}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}shutter\PYGZus{}repump\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{12}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}shutter\PYGZus{}OP1\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{14}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}shutter\PYGZus{}OP2\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{15}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}shutter\PYGZus{}science\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{10}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}AOM\PYGZus{}MOT\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}AOM\PYGZus{}repump\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{2}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}AOM\PYGZus{}OP\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{31}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}AOM\PYGZus{}science\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{3}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}coil\PYGZus{}MOTlower\PYGZus{}\PYGZus{}A\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{4}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}coil\PYGZus{}MOTupper\PYGZus{}\PYGZus{}A\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{4}\PYG{p}{,} \PYG{l+m+mi}{3}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}lockbox\PYGZus{}MOT\PYGZus{}\PYGZus{}MHz\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{3}\PYG{p}{,} \PYG{l+m+mi}{8}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}AOM\PYGZus{}science\PYGZus{}\PYGZus{}trans\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{4}\PYG{p}{,} \PYG{l+m+mi}{8}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}dispenser\PYGZus{}Rb\PYGZus{}\PYGZus{}A\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{3}\PYG{p}{,} \PYG{l+m+mi}{3}\PYG{p}{],}
\PYG{p}{)}

\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{`devices` stores how to map our physical quantities to an implementation voltage, as well as specifying the range of values that should be allowed for this variable.}

\PYG{l+s+sd}{These specifications are deliberately separated from `connection`s because they represent physical properties and conversions that are independent of the particular DAC wiring.}
\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{n}{devices} \PYG{o}{=} \PYG{n}{device}\PYG{o}{.}\PYG{n}{new}\PYG{p}{(}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}coil\PYGZus{}MOTlower\PYGZus{}\PYGZus{}A\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1} \PYG{o}{/} \PYG{l+m+mf}{2.0}\PYG{p}{,} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{5}\PYG{p}{,} \PYG{l+m+mi}{5}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}coil\PYGZus{}MOTupper\PYGZus{}\PYGZus{}A\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1} \PYG{o}{/} \PYG{l+m+mf}{2.0}\PYG{p}{,} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{5}\PYG{p}{,} \PYG{l+m+mi}{5}\PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}lockbox\PYGZus{}MOT\PYGZus{}\PYGZus{}MHz\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mf}{0.05}\PYG{p}{,} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{200}\PYG{p}{,} \PYG{l+m+mi}{200}\PYG{p}{],}
    \PYG{p}{[}
        \PYG{l+s+s2}{\PYGZdq{}AOM\PYGZus{}science\PYGZus{}\PYGZus{}trans\PYGZdq{}}\PYG{p}{,}
        \PYG{n}{conv}\PYG{o}{.}\PYG{n}{function\PYGZus{}from\PYGZus{}file}\PYG{p}{(}
            \PYG{l+s+s2}{\PYGZdq{}resources/calibration/aom\PYGZus{}calibration.dat\PYGZdq{}}\PYG{p}{,}
            \PYG{n}{sep}\PYG{o}{=}\PYG{l+s+sa}{r}\PYG{l+s+s2}{\PYGZdq{}\PYGZbs{}s+\PYGZdq{}}\PYG{p}{,}
        \PYG{p}{),}
        \PYG{l+m+mf}{0.0}\PYG{p}{,}
        \PYG{l+m+mf}{1.0}\PYG{p}{,}
    \PYG{p}{],}
    \PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}dispenser\PYGZus{}Rb\PYGZus{}\PYGZus{}A\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1} \PYG{o}{/} \PYG{l+m+mf}{3.0}\PYG{p}{,} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{3}\PYG{p}{,} \PYG{l+m+mi}{3}\PYG{p}{],}
\PYG{p}{)}


\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{\PYGZsq{}constants\PYGZsq{} allow us to store site\PYGZhy{}specific details that help define our experiment.}
\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{n}{constants} \PYG{o}{=} \PYG{n}{Munch}\PYG{p}{(}
    \PYG{n}{safety\PYGZus{}factor}\PYG{o}{=}\PYG{l+m+mf}{1.1}\PYG{p}{,}
    \PYG{n}{lag\PYGZus{}MOT\PYGZus{}shutter}\PYG{o}{=}\PYG{l+m+mf}{2.3e\PYGZhy{}3}\PYG{p}{,}
    \PYG{n}{lag\PYGZus{}repump\PYGZus{}shutter}\PYG{o}{=}\PYG{l+m+mf}{2.3e\PYGZhy{}3}\PYG{p}{,}
    \PYG{n}{Compensation}\PYG{o}{=}\PYG{n}{Munch}\PYG{p}{(}
        \PYG{n}{Z\PYGZus{}\PYGZus{}A}\PYG{o}{=\PYGZhy{}}\PYG{l+m+mf}{0.1}\PYG{p}{,}
        \PYG{n}{Y\PYGZus{}\PYGZus{}A}\PYG{o}{=}\PYG{l+m+mf}{1.5}\PYG{p}{,}
        \PYG{n}{X\PYGZus{}\PYGZus{}A}\PYG{o}{=}\PYG{l+m+mf}{0.25}\PYG{p}{,}
    \PYG{p}{),}
    \PYG{n}{OP}\PYG{o}{=}\PYG{n}{Munch}\PYG{p}{(}
        \PYG{n}{lag\PYGZus{}AOM\PYGZus{}on}\PYG{o}{=}\PYG{l+m+mf}{15e\PYGZhy{}6}\PYG{p}{,}
        \PYG{n}{lag\PYGZus{}shutter\PYGZus{}on}\PYG{o}{=}\PYG{l+m+mf}{1.48e\PYGZhy{}3}\PYG{p}{,}
        \PYG{n}{lag\PYGZus{}shutter\PYGZus{}off}\PYG{o}{=}\PYG{l+m+mf}{1.78e\PYGZhy{}3}\PYG{p}{,}
        \PYG{n}{duration\PYGZus{}shutter\PYGZus{}on}\PYG{o}{=}\PYG{l+m+mf}{140e\PYGZhy{}6}\PYG{p}{,}
    \PYG{p}{),}
\PYG{p}{)}


